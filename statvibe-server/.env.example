# StatVibe Server — Vercel project: statvibe-server
# Target: https://statvibe-server.vercel.app

PORT=4173
HOST=0.0.0.0

# Durable DB (Mongo preferred). DATABASE_URL is an alias for MONGO_URI.
DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/DB?retryWrites=true&w=majority
# MONGO_URI=  (optional alias)

# CORS — allow the main web app origin
CLIENT_URL=https://stat-vibe.vercel.app

# Session / future JWT signing (current auth uses durable session tokens)
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USER=GenAdmin
ADMIN_PASSWORD=change-me-in-production
ADMIN_TOKEN=change-me-in-production

# Hosted AI (OpenAI-compatible)
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=openrouter/auto
AI_MAX_TOKENS=2048

# PayMongo checkout + webhooks (GCash, Maya, cards)
# PAYMONGO_SECRET_KEY=sk_test_xxx
# PAYMONGO_WEBHOOK_SECRET=whsec_xxx
# USD_PHP_RATE=56

# Optional Cloudinary fallback store / CDN
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
