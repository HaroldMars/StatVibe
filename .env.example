# Copy to .env and adjust for your environment.
# The server auto-loads .env at startup (existing env vars take precedence).
# .env is gitignored — never commit real secrets.

PORT=4173
HOST=0.0.0.0

# URL of your Ollama instance (free, local AI). Leave default for a local install.
OLLAMA_HOST=http://127.0.0.1:11434

# Admin / developer console identity + credential.
# ADMIN_USER is a display name (safe to show); ADMIN_TOKEN is the secret.
# CHANGE THE TOKEN in production.
# The founder developer account is seeded from these on first boot.
# Sign in to the separate developer console at /admin with these credentials.
ADMIN_USER=GenAdmin
ADMIN_PASSWORD=change-me-in-production
# Static admin token for automation (x-admin-token header):
ADMIN_TOKEN=change-me-in-production

# --- Vercel production ---
# Durable storage on Vercel: add "Vercel KV" (Storage tab) — it injects these
# automatically. Without them the app uses /tmp on Vercel, which is EPHEMERAL
# (accounts vanish on cold starts), so add KV for a real deployment.
# KV_REST_API_URL=https://xxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxx
# Hosted AI for production (recommended for Vercel). Any OpenAI-compatible chat
# endpoint — Groq (free/fast, runs Llama), OpenRouter, Together, OpenAI, etc.
# Used automatically when Ollama isn't reachable. Get a free key at groq.com.
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
# Or point at a PUBLIC Ollama server instead of a hosted API:
# OLLAMA_HOST=https://your-ollama-server:11434
# PayMongo (server-side only — never expose the secret key to the client):
# PAYMONGO_SECRET_KEY=sk_live_xxx
# PAYMONGO_WEBHOOK_SECRET=whsec_xxx

# Cloudinary (optional — enables optimized image delivery in the app UI):
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
